# ─────────────────────────────────────────────────────────────────────────────
# CrimeNet AI — Environment Configuration
# Copy this file to `.env` and adjust values for your deployment.
# NEVER commit real secrets. All values here are demo/dev defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=CrimeNet AI
DEBUG=false

# ── Neo4j Graph Database ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimenet2025
NEO4J_DATABASE=neo4j

# ── PostgreSQL (relational / audit / reports) ────────────────────────────────
POSTGRES_URL=postgresql://postgres:crimenet@localhost:5432/crimenetdb

# ── Redis (cache / sessions) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication / JWT ─────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-crimenet-2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── ML / Model loading ───────────────────────────────────────────────────────
# When true, heavy models (BERT NER, XGBoost, GNN) are loaded at startup.
ML_LOAD_MODELS=true
NLP_MODEL_NAME=bert-base-multilingual-cased
NLP_CONFIDENCE_THRESHOLD=0.75
RISK_MODEL_PATH=backend/data/models/risk_xgb.json

# ── Synthetic data seeding ───────────────────────────────────────────────────
LOAD_SYNTHETIC_DATA=true
SYNTHETIC_CRIMINALS=500
SYNTHETIC_ORGANIZATIONS=50
SYNTHETIC_LOCATIONS=200

# ── Rate limiting / security ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
MAX_FAILED_LOGIN_ATTEMPTS=5
SESSION_TIMEOUT_HOURS=8

# ── Report / share ───────────────────────────────────────────────────────────
REPORT_STORAGE_DIR=backend/data/reports
EVIDENCE_STORAGE_DIR=backend/data/evidence
SHARE_BASE_URL=http://localhost:3000/public/report
